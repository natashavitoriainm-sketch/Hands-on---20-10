        int[] numeros = new int[10];
        
       for (int i = 0; i < 10; i++) {
        System.out.println("Digite um numero inteiro: ");
        numeros[i] = sc.nextInt();
       }
       
       for (int i = 0; i < 10; i++) {
        int numero = numeros[i];  
       
       if (numero > 1) {
           boolean primo = true;
           
       for (int j =2; j < numero; j++) {
            
            
         if (numero % j ==0) {
            primo = false; 
            break;
         }   
        }
        if (primo) {
        System.out.println("Número: " + numero + " Posição: " + (i + 1)); 
        }
       }
     }
    }
}

